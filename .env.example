# Discobrain Application Secret Key
DISCOBRAIN_SECRET_KEY=dev-secret-key-change-me

# Discogs Authentication Options:
# Option 1: Personal Access Token (Recommended for local use)
# Generate at: https://www.discogs.com/settings/developers
DISCOGS_USER_TOKEN=

# Option 2: Discogs OAuth 1.0a Application
# Create application at: https://www.discogs.com/settings/developers
# Set Callback URL to: http://localhost:5000/discogs/auth
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
